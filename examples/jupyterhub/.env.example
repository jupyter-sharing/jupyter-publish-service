# Copy to `.env` and fill in real secrets to override the demo defaults baked
# into docker-compose.yml. docker compose loads `.env` automatically.
#
# Generate strong values with:  openssl rand -hex 32

# Shared between the Hub (registers the `publish` service) and the publishing
# service (used as its service-owned token to call the Hub API).
PUBLISH_SERVICE_API_TOKEN=

# Pre-minted Hub API tokens for the two demo users.
ALICE_TOKEN=
BOB_TOKEN=

# JWKS URL for the standalone-Lab (lab-local) authority. The demo never
# exercises it; a placeholder is fine.
LAB_JWKS_URL=https://idp.example.com/.well-known/jwks.json
